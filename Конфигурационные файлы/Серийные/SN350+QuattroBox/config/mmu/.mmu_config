# CONFIG_MMU_CUSTOM_TYPE_EVERYTHING is not set
CONFIG_PARAM_DISPLAY_NAME="QuattroBox"
CONFIG_PARAM_BOARD_TYPE="Unknown" #~DEFAULT~#
# CONFIG_BOARD_TYPE_AFC_LITE_1_0 is not set
CONFIG_PIN_GEAR_UART="PC13"
CONFIG_PIN_GEAR_STEP="PE4"
CONFIG_PIN_GEAR_DIR="PE6"
CONFIG_PIN_GEAR_ENABLE="PE5"
CONFIG_PIN_GEAR_DIAG="" #~DEFAULT~#
CONFIG_PIN_GEAR_UART_1="PA5"
CONFIG_PIN_GEAR_STEP_1="PC4"
CONFIG_PIN_GEAR_DIR_1="PA6"
CONFIG_PIN_GEAR_ENABLE_1="PA7"
CONFIG_PIN_GEAR_DIAG_1="" #~DEFAULT~#
CONFIG_PIN_GEAR_UART_2="PE7"
CONFIG_PIN_GEAR_STEP_2="PC5"
CONFIG_PIN_GEAR_DIR_2="PB1"
CONFIG_PIN_GEAR_ENABLE_2="PB0"
CONFIG_PIN_GEAR_DIAG_2="" #~DEFAULT~#
CONFIG_PIN_GEAR_UART_3="PE11"
CONFIG_PIN_GEAR_STEP_3="PE14"
CONFIG_PIN_GEAR_DIR_3="PE13"
CONFIG_PIN_GEAR_ENABLE_3="PE12"
CONFIG_PIN_GEAR_DIAG_3="" #~DEFAULT~#
CONFIG_PIN_ENTRY_SENSOR_0="PC2"
CONFIG_PIN_ENTRY_SENSOR_1="PC1"
CONFIG_PIN_ENTRY_SENSOR_2="PC0"
CONFIG_PIN_ENTRY_SENSOR_3="PD7"
CONFIG_PIN_EXIT_SENSOR_0="PD6"
CONFIG_PIN_EXIT_SENSOR_1="PD5"
CONFIG_PIN_EXIT_SENSOR_2="PD4"
CONFIG_PIN_EXIT_SENSOR_3="PD3"
CONFIG_PIN_BUFFER_NEOPIXEL="" #~DEFAULT~#
