CONFIG_PARAM_MMU_VARS_CFG="~/printer_data/config/mmu/mmu_vars.cfg" #~DEFAULT~#
CONFIG_SERVICE_KLIPPER="klipper.service"
CONFIG_SERVICE_MOONRAKER="moonraker.service"
CONFIG_INIT_SYSTEMD=y
CONFIG_PARAM_VENDOR="QuattroBox" #~DEFAULT~#
CONFIG_PARAM_VERSION="1.0" #~DEFAULT~#
# CONFIG_MMU_TYPE_3D_CHAMELEON_1_0 is not set
CONFIG_MMU_HAS_LEDS=y #~DEFAULT~#
CONFIG_BOOL_ENABLE_LEDS=y #~DEFAULT~#
CONFIG_PARAM_ENABLED="True" #~DEFAULT~#
CONFIG_BOOL_ENABLE_LEDS_ANIMATION=y #~DEFAULT~#
CONFIG_PARAM_ANIMATION="True" #~DEFAULT~#
CONFIG_PARAM_FRAME_RATE=24 #~DEFAULT~#
CONFIG_PARAM_EXIT_LEDS="neopixel:unit0_leds (1-4)" #~DEFAULT~#
CONFIG_PARAM_ENTRY_LEDS="" #~DEFAULT~#
CONFIG_PARAM_STATUS_LEDS="neopixel:unit0_leds (5-14)" #~DEFAULT~#
CONFIG_PARAM_LOGO_LEDS="neopixel:unit0_leds (15-32)" #~DEFAULT~#
CONFIG_PARAM_CHAIN_COUNT=32 #~DEFAULT~#
CONFIG_PARAM_COLOR_ORDER="GRBW,GRBW,GRBW,GRBW,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB,GRB" #~DEFAULT~#
CONFIG_PIN_NEOPIXEL="PC11"
# CONFIG_MMU_HAS_FANS is not set #~DEFAULT~#
CONFIG_MMU_HAS_SYNC_FEEDBACK_BUFFER=y
CONFIG_PARAM_SYNC_FEEDBACK_BUFFER_NAME="unit0" #~DEFAULT~#
CONFIG_PARAM_BUFFER_RANGE=20
CONFIG_PARAM_BUFFER_MAXRANGE=20
# CONFIG_CHOICE_BUFFER_SPRING_STATE_TENSION is not set #~DEFAULT~#
CONFIG_CHOICE_BUFFER_SPRING_STATE_NEUTRAL=y
# CONFIG_CHOICE_BUFFER_SPRING_STATE_COMPRESSION is not set #~DEFAULT~#
# CONFIG_CHOICE_BUFFER_SPRING_STATE_NONE is not set #~DEFAULT~#
CONFIG_PARAM_BUFFER_SPRING_STATE="neutral" #~DEFAULT~#
CONFIG_MMU_HAS_SENSOR_BUFFER_COMPRESSION=y
CONFIG_PIN_BUFFER_COMPRESSION="PE2"
CONFIG_MMU_HAS_SENSOR_BUFFER_TENSION=y
CONFIG_PIN_BUFFER_TENSION="PE3"
# CONFIG_MMU_HAS_SENSOR_BUFFER_PROPORTIONAL is not set #~DEFAULT~#
CONFIG_PARAM_REGISTER_BUFFER_SENSORS=1 #~DEFAULT~#
CONFIG_PARAM_SYNC_FEEDBACK_SPEED_MULTIPLIER=5 #~DEFAULT~#
CONFIG_PARAM_SYNC_FEEDBACK_BOOST_MULTIPLIER=3 #~DEFAULT~#
CONFIG_PARAM_SYNC_FEEDBACK_EXTRUDE_THRESHOLD=5 #~DEFAULT~#
CONFIG_PARAM_SYNC_FEEDBACK_DEBUG_LOG=1
# CONFIG_MMU_HAS_ENVIRONMENT_SENSOR is not set #~DEFAULT~#
CONFIG_BOOL_CREATE_MCU_ENVIRONMENT_SENSORS=y #~DEFAULT~#
# CONFIG_BOOL_HIDE_MCU_ENVIRONMENT_SENSORS is not set #~DEFAULT~#
# CONFIG_MMU_HAS_HEATER is not set #~DEFAULT~#
# CONFIG_MMU_HAS_NFC_READER is not set #~DEFAULT~#
CONFIG_MMU_HAS_EJECT_BUTTONS=y #~DEFAULT~#
CONFIG_PIN_EJECT_BUTTON_0="PC9"
CONFIG_PIN_EJECT_BUTTON_1="PC8"
CONFIG_PIN_EJECT_BUTTON_2="PC12"
CONFIG_PIN_EJECT_BUTTON_3="PD2"
CONFIG_MMU_HAS_ENCODER=y #~DEFAULT~#
CONFIG_PARAM_ENCODER_NAME="unit0" #~DEFAULT~#
# CONFIG_CHOICE_ENCODER_TYPE_BINKY_8 is not set #~DEFAULT~#
# CONFIG_CHOICE_ENCODER_TYPE_BINKY_10 is not set #~DEFAULT~#
CONFIG_CHOICE_ENCODER_TYPE_BINKY_12=y #~DEFAULT~#
# CONFIG_CHOICE_ENCODER_TYPE_TCRT5000 is not set #~DEFAULT~#
# CONFIG_CHOICE_ENCODER_TYPE_OTHER is not set #~DEFAULT~#
CONFIG_PARAM_ENCODER_RESOLUTION=0.979 #~DEFAULT~#
CONFIG_PARAM_GATE_ENDSTOP_TO_ENCODER=18 #~DEFAULT~#
CONFIG_PIN_ENCODER="PC3"
CONFIG_PARAM_REGISTER_AS_SENSOR=1 #~DEFAULT~#
CONFIG_PARAM_BOWDEN_APPLY_CORRECTION=0 #~DEFAULT~#
CONFIG_PARAM_BOWDEN_ALLOWABLE_ENCODER_DELTA=20.0 #~DEFAULT~#
CONFIG_PARAM_BOWDEN_PRE_UNLOAD_TEST=1 #~DEFAULT~#
CONFIG_PARAM_ENCODER_MOVE_VALIDATION=1 #~DEFAULT~#
# CONFIG_MMU_HAS_ESPOOLER is not set #~DEFAULT~#
# CONFIG_MMU_HAS_FILAMENT_BUFFER is not set #~DEFAULT~#
CONFIG_MMU_HAS_SENSOR_ENTRY=y
CONFIG_MMU_HAS_SENSOR_EXIT=y
# CONFIG_MMU_HAS_SENSOR_SHARED_EXIT is not set #~DEFAULT~#
# CONFIG_MMU_HAS_SENSOR_GEAR_TOUCH is not set #~DEFAULT~#
CONFIG_PARAM_REGISTER_MMU_SENSORS=1 #~DEFAULT~#
CONFIG_VIRTUAL_SELECTOR=y
CONFIG_PARAM_SELECTOR_TYPE="VirtualSelector" #~DEFAULT~#
CONFIG_MULTIGEAR=y
CONFIG_PARAM_HAS_BYPASS=0 #~DEFAULT~#
CONFIG_PARAM_VARIABLE_BOWDEN_LENGTHS=1 #~DEFAULT~#
CONFIG_PARAM_VARIABLE_ROTATION_DISTANCES=1 #~DEFAULT~#
CONFIG_PARAM_FILAMENT_ALWAYS_GRIPPED=1 #~DEFAULT~#
CONFIG_PARAM_NUM_GATES=4 #~DEFAULT~#
CONFIG_PARAM_GEAR_GEAR_RATIO="1:1"
CONFIG_PARAM_GEAR_RUN_CURRENT=1.1
CONFIG_PARAM_GEAR_HOLD_CURRENT=0.2 #~DEFAULT~#
CONFIG_PARAM_GATE_PARKING_DISTANCE=-30 #~DEFAULT~#
CONFIG_PARAM_GATE_HOMING_MAX=200 #~DEFAULT~#
# CONFIG_MMU_TYPE_3MS_1_0 is not set
CONFIG_PARAM_GATE_PRELOAD_HOMING_MAX=200 #~DEFAULT~#
CONFIG_PARAM_GATE_FINAL_EJECT_DISTANCE=200 #~DEFAULT~#
# CONFIG_MMU_TYPE_ANGRY_BEAVER_1_0 is not set
# CONFIG_MMU_TYPE_BOX_TURTLE_1_0 is not set
CONFIG_PARAM_SYNC_GEAR_CURRENT=100 #~DEFAULT~#
CONFIG_PARAM_GATE_PRELOAD_PARKING_DISTANCE=-30 #~DEFAULT~#
# CONFIG_MMU_TYPE_EMU_1_0 is not set
CONFIG_PARAM_GEAR_MICROSTEPS=16 #~DEFAULT~#
# CONFIG_MMU_FAMILY_ERCF is not set
CONFIG_PARAM_GATE_LOAD_ATTEMPTS=1 #~DEFAULT~#
CONFIG_PARAM_SKIP_CAL_ENCODER=1 #~DEFAULT~#
# CONFIG_MMU_TYPE_HTLF_1_0 is not set
CONFIG_PARAM_GEAR_ROTATION_DISTANCE=23.25
# CONFIG_MMU_TYPE_KMS_1_0 is not set
# CONFIG_MMU_TYPE_LOW_RIDER_1_0 is not set
CONFIG_PARAM_GEAR_FULL_STEPS_PER_ROTATION=200 #~DEFAULT~#
# CONFIG_MMU_TYPE_MMX_1_0 is not set
# CONFIG_MMU_TYPE_MMX6_1_0 is not set
# CONFIG_MMU_TYPE_NIGHT_OWL_1_0 is not set
# CONFIG_MMU_TYPE_PICO_MMU_1_0 is not set
# CONFIG_MMU_TYPE_QIDI_BOX_1_0 is not set
CONFIG_MMU_FAMILY_QUATTRO_BOX=y
CONFIG_MMU_TYPE_QUATTRO_BOX_1_0=y
