CONFIG_SHOW_PER_UNIT_WARNINGS=y
CONFIG_W2=y
CONFIG_W3=y
#   _
#   _Config Warnings / Errors
#   Custom MMU selected. You will need to carefully check configuration
#   Unknown MCU board selected. You will need to configure all pins
#   Toolhead type is 'other'. Are you sure yours is not listed?
#   No gate homing endstop configured
#   Parking must be a retraction (<=0) unless gate endstop is mmu_exit
#   Leds are enabled but no MCU pin defined
#   Fans are enabled but no MCU pin defined
#   Encoder is enabled but no MCU pin defined
#   Shared exit sensor is enabled but no MCU pin defined
#   Buffer tension switch is enabled but no MCU pin defined
#   Buffer compression switch is enabled but no MCU pin defined
#   Buffer proportional feedback enabled but no analog MCU pin defined
#   MMU heater is enabled but heater name(s) not defined
#   MMU environment sensor is enabled but sensor name(s) not defined
#   Sync-feedback buffer configured but it had no sensors defined
#   Warning: Sync-feedback buffer configured with both analog and digital inputs
#   NFC neighbor eviction jog must be backward (<=0) unless gate endstop is mmu_exit
#   NFC gate clear jog must be backward (<=0) unless gate endstop is mmu_exit
#   NFC preload clear jog must be backward (<=0) unless preload endstop is mmu_exit
#   Servo gate angle count must match the number of gates
